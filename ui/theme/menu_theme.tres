[gd_resource type="Theme" load_steps=4 format=3]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_btn"]
content_margin_left = 4.0
content_margin_top = 2.0
content_margin_right = 4.0
content_margin_bottom = 2.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 32.0
content_margin_top = 28.0
content_margin_right = 32.0
content_margin_bottom = 28.0
bg_color = Color(0.055, 0.06, 0.08, 0.96)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.32, 0.27, 0.2, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_focus"]
draw_center = false
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.72, 0.4, 0.9)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
expand_margin_left = 6.0
expand_margin_top = 4.0
expand_margin_right = 6.0
expand_margin_bottom = 4.0

[resource]
CheckButton/styles/focus = SubResource("StyleBoxFlat_focus")
HSlider/styles/focus = SubResource("StyleBoxFlat_focus")
default_font_size = 20
Button/colors/font_color = Color(0.5, 0.52, 0.58, 1)
Button/colors/font_disabled_color = Color(0.3, 0.3, 0.33, 1)
Button/colors/font_focus_color = Color(1, 0.86, 0.62, 1)
Button/colors/font_hover_color = Color(1, 0.86, 0.62, 1)
Button/colors/font_hover_pressed_color = Color(1, 0.93, 0.8, 1)
Button/colors/font_pressed_color = Color(1, 0.93, 0.8, 1)
Button/font_sizes/font_size = 30
Button/styles/disabled = SubResource("StyleBoxEmpty_btn")
Button/styles/focus = SubResource("StyleBoxEmpty_btn")
Button/styles/hover = SubResource("StyleBoxEmpty_btn")
Button/styles/normal = SubResource("StyleBoxEmpty_btn")
Button/styles/pressed = SubResource("StyleBoxEmpty_btn")
Label/colors/font_color = Color(0.72, 0.73, 0.77, 1)
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel")
